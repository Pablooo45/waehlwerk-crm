{
  "name": "waehlwerk-crm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Eigenes CRM mit Browser-Telefonie (Twilio), Power Dialer, Aufnahmen, Calendly und Google Kalender.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:functions": "cd supabase/functions && deno test --allow-env _tests/",
    "test:db": "scripts/test-db.sh",
    "build:demo-page": "vite build --mode demo && node scripts/demo-page.mjs"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@supabase/supabase-js": "2.117.2",
    "@twilio/voice-sdk": "2.18.5",
    "libphonenumber-js": "1.13.14",
    "lucide-react": "1.52.0",
    "papaparse": "5.5.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.3"
  }
}
